# Add to /srv/proxy/Caddyfile, then reload Caddy.
# The Discogs token lives on the server in /srv/apps/vinyl/data/discogs-token (never in git);
# vinyl-api adds it to each request and keeps Discogs answers in its database (server/discogs.mjs).
my-vinyl-library.jacob-apps.co.il {
	# Discogs lookups, through vinyl-api's cache
	handle /api/discogs/* {
		reverse_proxy vinyl-api:8080
	}
	# contact messages, usage stats and the developer page
	handle /api/app/* {
		reverse_proxy vinyl-api:8080
	}
	handle {
		reverse_proxy vinyl:80
	}
}
